{
  "manifest_version": 3,
  "name": "Sync for Zotero",
  "version": "0.0.20",
  "description": "Super-Bridge connecting Zotero with ChatGPT, DeepSeek, Google Gemini and bidirectional NotebookLM sync (NZBridge)",
  "minimum_chrome_version": "102",
  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "scripting",
    "alarms",
    "debugger"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.deepseek.com/*",
    "https://gemini.google.com/*",
    "https://notebooklm.google.com/*",
    "https://notebook.google.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.deepseek.com/*"],
      "js": ["injected.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.deepseek.com/*",
        "https://gemini.google.com/*",
        "https://notebooklm.google.com/*",
        "https://notebook.google.com/*"
      ],
      "js": [
        "webchat_shared.js",
        "gemini_adapter.js",
        "notebooklm_adapter.js",
        "content_script.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://notebooklm.google.com/*",
        "https://notebook.google.com/*"
      ],
      "js": [
        "nzbridge_content.js",
        "noteExtractor.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Sync for Zotero (NZBridge Super-Bridge)"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
